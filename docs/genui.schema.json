{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "render_ui",
 "description": "A screen built only from catalogued mojoui components, drawn natively by the app. Data, never code: text is shown as text. Beyond this schema the app refuses more than 8 levels, 200 components or 32768 bytes.",
 "type": "object",
 "properties": {
  "ui": {
   "$ref": "#/$defs/node"
  }
 },
 "required": [
  "ui"
 ],
 "additionalProperties": false,
 "$defs": {
  "node": {
   "oneOf": [
    {
     "$ref": "#/$defs/components/Card"
    },
    {
     "$ref": "#/$defs/components/VStack"
    },
    {
     "$ref": "#/$defs/components/HStack"
    },
    {
     "$ref": "#/$defs/components/Grid"
    },
    {
     "$ref": "#/$defs/components/Tabs"
    },
    {
     "$ref": "#/$defs/components/Divider"
    },
    {
     "$ref": "#/$defs/components/Spacer"
    },
    {
     "$ref": "#/$defs/components/Text"
    },
    {
     "$ref": "#/$defs/components/Paragraph"
    },
    {
     "$ref": "#/$defs/components/Markdown"
    },
    {
     "$ref": "#/$defs/components/CodeBlock"
    },
    {
     "$ref": "#/$defs/components/Chip"
    },
    {
     "$ref": "#/$defs/components/Alert"
    },
    {
     "$ref": "#/$defs/components/Skeleton"
    },
    {
     "$ref": "#/$defs/components/Table"
    },
    {
     "$ref": "#/$defs/components/DataGrid"
    },
    {
     "$ref": "#/$defs/components/ChartView"
    },
    {
     "$ref": "#/$defs/components/Sparkline"
    },
    {
     "$ref": "#/$defs/components/KpiView"
    },
    {
     "$ref": "#/$defs/components/Meter"
    },
    {
     "$ref": "#/$defs/components/ProgressBar"
    },
    {
     "$ref": "#/$defs/components/Timeline"
    },
    {
     "$ref": "#/$defs/components/MapView"
    },
    {
     "$ref": "#/$defs/components/Breadcrumbs"
    },
    {
     "$ref": "#/$defs/components/Icon"
    },
    {
     "$ref": "#/$defs/components/Button"
    },
    {
     "$ref": "#/$defs/components/TextField"
    },
    {
     "$ref": "#/$defs/components/TextArea"
    },
    {
     "$ref": "#/$defs/components/Toggle"
    },
    {
     "$ref": "#/$defs/components/Checkbox"
    },
    {
     "$ref": "#/$defs/components/Dropdown"
    },
    {
     "$ref": "#/$defs/components/Slider"
    },
    {
     "$ref": "#/$defs/components/Segmented"
    },
    {
     "$ref": "#/$defs/components/Radio"
    },
    {
     "$ref": "#/$defs/components/DatePicker"
    },
    {
     "$ref": "#/$defs/components/Confirm"
    }
   ]
  },
  "components": {
   "Card": {
    "type": "object",
    "description": "a surface holding components, with an optional title and subtitle",
    "properties": {
     "component": {
      "const": "Card"
     },
     "title": {
      "type": "string",
      "maxLength": 200
     },
     "subtitle": {
      "type": "string",
      "maxLength": 300
     },
     "tone": {
      "enum": [
       "plain",
       "good",
       "warn"
      ],
      "description": "warn asks for attention, good confirms"
     },
     "children": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "$ref": "#/$defs/node"
      },
      "description": "the components inside, in order"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "VStack": {
    "type": "object",
    "description": "components in a column",
    "properties": {
     "component": {
      "const": "VStack"
     },
     "gap": {
      "enum": [
       "xs",
       "s",
       "m",
       "l"
      ]
     },
     "children": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "$ref": "#/$defs/node"
      },
      "description": "the components inside, in order"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "HStack": {
    "type": "object",
    "description": "components in a row",
    "properties": {
     "component": {
      "const": "HStack"
     },
     "gap": {
      "enum": [
       "xs",
       "s",
       "m",
       "l"
      ]
     },
     "children": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "$ref": "#/$defs/node"
      },
      "description": "the components inside, in order"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Grid": {
    "type": "object",
    "description": "components in rows of equal columns (tiles, KPI rows, galleries)",
    "properties": {
     "component": {
      "const": "Grid"
     },
     "columns": {
      "type": "number",
      "minimum": 1,
      "maximum": 6
     },
     "children": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "$ref": "#/$defs/node"
      },
      "description": "the components inside, in order"
     }
    },
    "required": [
     "component",
     "columns"
    ],
    "additionalProperties": false
   },
   "Tabs": {
    "type": "object",
    "description": "sections the user switches between: one child per tab, in order",
    "properties": {
     "component": {
      "const": "Tabs"
     },
     "tabs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "type": "string",
       "maxLength": 100
      },
      "description": "the tab titles"
     },
     "children": {
      "type": "array",
      "maxItems": 50,
      "items": {
       "$ref": "#/$defs/node"
      },
      "description": "the components inside, in order"
     }
    },
    "required": [
     "component",
     "tabs"
    ],
    "additionalProperties": false
   },
   "Divider": {
    "type": "object",
    "description": "a rule between components",
    "properties": {
     "component": {
      "const": "Divider"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Spacer": {
    "type": "object",
    "description": "empty room that pushes its neighbours apart in a row",
    "properties": {
     "component": {
      "const": "Spacer"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Text": {
    "type": "object",
    "description": "a line of text (shown as text, never markup)",
    "properties": {
     "component": {
      "const": "Text"
     },
     "text": {
      "type": "string",
      "maxLength": 2000
     },
     "style": {
      "enum": [
       "body",
       "title",
       "headline",
       "caption"
      ]
     },
     "tone": {
      "enum": [
       "plain",
       "accent",
       "good",
       "warn",
       "strong"
      ]
     }
    },
    "required": [
     "component",
     "text"
    ],
    "additionalProperties": false
   },
   "Paragraph": {
    "type": "object",
    "description": "wrapping text",
    "properties": {
     "component": {
      "const": "Paragraph"
     },
     "text": {
      "type": "string",
      "maxLength": 4000
     }
    },
    "required": [
     "component",
     "text"
    ],
    "additionalProperties": false
   },
   "Markdown": {
    "type": "object",
    "description": "formatted text: headings, lists, bold, italics, code, links (http/https only; never HTML)",
    "properties": {
     "component": {
      "const": "Markdown"
     },
     "text": {
      "type": "string",
      "maxLength": 8000
     }
    },
    "required": [
     "component",
     "text"
    ],
    "additionalProperties": false
   },
   "CodeBlock": {
    "type": "object",
    "description": "code in a monospaced block with a Copy button",
    "properties": {
     "component": {
      "const": "CodeBlock"
     },
     "code": {
      "type": "string",
      "maxLength": 8000
     },
     "language": {
      "type": "string",
      "maxLength": 30
     }
    },
    "required": [
     "component",
     "code"
    ],
    "additionalProperties": false
   },
   "Chip": {
    "type": "object",
    "description": "a small pill: a tag, a status",
    "properties": {
     "component": {
      "const": "Chip"
     },
     "text": {
      "type": "string",
      "maxLength": 60
     },
     "hue": {
      "type": "number",
      "minimum": 0,
      "maximum": 6,
      "description": "0 quiet, 1\u20136 the data colours"
     }
    },
    "required": [
     "component",
     "text"
    ],
    "additionalProperties": false
   },
   "Alert": {
    "type": "object",
    "description": "an inline note or warning",
    "properties": {
     "component": {
      "const": "Alert"
     },
     "title": {
      "type": "string",
      "maxLength": 200
     },
     "text": {
      "type": "string",
      "maxLength": 1000
     },
     "tone": {
      "enum": [
       "info",
       "warn"
      ]
     }
    },
    "required": [
     "component",
     "text"
    ],
    "additionalProperties": false
   },
   "Skeleton": {
    "type": "object",
    "description": "placeholder lines for something still loading",
    "properties": {
     "component": {
      "const": "Skeleton"
     },
     "lines": {
      "type": "number",
      "minimum": 1,
      "maximum": 12
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Table": {
    "type": "object",
    "description": "rows of cells under column titles",
    "properties": {
     "component": {
      "const": "Table"
     },
     "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
       "type": "string",
       "maxLength": 100
      },
      "description": "the column titles"
     },
     "rows": {
      "type": "array",
      "maxItems": 100,
      "items": {
       "type": "array",
       "maxItems": 10,
       "items": {
        "type": [
         "string",
         "number"
        ],
        "maxLength": 200,
        "minimum": -1000000000000000,
        "maximum": 1000000000000000
       }
      },
      "description": "each row: a list of strings or numbers"
     }
    },
    "required": [
     "component",
     "columns",
     "rows"
    ],
    "additionalProperties": false
   },
   "DataGrid": {
    "type": "object",
    "description": "a scrolling grid for many rows: up to 1,000 sent inline (columns + rows), or any number from a dataset the app holds (dataset: its name; the rows never travel)",
    "properties": {
     "component": {
      "const": "DataGrid"
     },
     "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "string",
       "maxLength": 100
      },
      "description": "the column titles"
     },
     "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
       "type": "array",
       "maxItems": 20,
       "items": {
        "type": [
         "string",
         "number"
        ],
        "maxLength": 200,
        "minimum": -1000000000000000,
        "maximum": 1000000000000000
       }
      },
      "description": "each row: a list of strings or numbers"
     },
     "dataset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$",
      "description": "a dataset the app holds, by name (see the run's context)"
     },
     "title": {
      "type": "string",
      "maxLength": 200
     },
     "height": {
      "type": "number",
      "minimum": 120,
      "maximum": 800,
      "description": "points"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "ChartView": {
    "type": "object",
    "description": "a chart of values by label, bars or a line: the values sent (labels + values), or computed by the app from a dataset it holds (dataset, group_by, value, combine)",
    "properties": {
     "component": {
      "const": "ChartView"
     },
     "kind": {
      "enum": [
       "bar",
       "line"
      ]
     },
     "title": {
      "type": "string",
      "maxLength": 200
     },
     "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
       "type": "string",
       "maxLength": 100
      },
      "description": "one per value"
     },
     "values": {
      "type": "array",
      "maxItems": 60,
      "items": {
       "type": "number",
       "minimum": -1000000000000000,
       "maximum": 1000000000000000
      },
      "description": "the numbers, one per label"
     },
     "value_name": {
      "type": "string",
      "maxLength": 60,
      "description": "what the numbers are"
     },
     "money": {
      "type": "boolean",
      "description": "values are amounts of money (cents)"
     },
     "dataset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$",
      "description": "a dataset the app holds, by name"
     },
     "group_by": {
      "type": "string",
      "maxLength": 60,
      "description": "a text column of the dataset: one bar per value"
     },
     "value": {
      "type": "string",
      "maxLength": 60,
      "description": "a number column of the dataset"
     },
     "combine": {
      "enum": [
       "sum",
       "average",
       "count"
      ]
     },
     "top": {
      "type": "number",
      "minimum": 1,
      "maximum": 50,
      "description": "the largest this many groups"
     },
     "height": {
      "type": "number",
      "minimum": 140,
      "maximum": 600,
      "description": "points"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Sparkline": {
    "type": "object",
    "description": "a small line chart of numbers",
    "properties": {
     "component": {
      "const": "Sparkline"
     },
     "values": {
      "type": "array",
      "maxItems": 500,
      "items": {
       "type": "number",
       "minimum": -1000000000000000,
       "maximum": 1000000000000000
      },
      "description": "the numbers (or bind them to the state)"
     },
     "bind": {
      "type": "string",
      "pattern": "^(/[A-Za-z0-9_][A-Za-z0-9_-]{0,39}){1,6}$",
      "description": "a JSON pointer into the shared state (\"/form/name\"): the value shown, and where edits go"
     },
     "label": {
      "type": "string",
      "maxLength": 200
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "KpiView": {
    "type": "object",
    "description": "a headline number with its label, a note and a small trend line",
    "properties": {
     "component": {
      "const": "KpiView"
     },
     "label": {
      "type": "string",
      "maxLength": 80
     },
     "value": {
      "type": "string",
      "maxLength": 40
     },
     "note": {
      "type": "string",
      "maxLength": 80
     },
     "tone": {
      "enum": [
       "plain",
       "good",
       "warn"
      ],
      "description": "the note's"
     },
     "spark": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "number",
       "minimum": -1000000000000000,
       "maximum": 1000000000000000
      },
      "description": "the trend"
     },
     "accent": {
      "type": "boolean",
      "description": "the focal number"
     }
    },
    "required": [
     "component",
     "label",
     "value"
    ],
    "additionalProperties": false
   },
   "Meter": {
    "type": "object",
    "description": "how full something is",
    "properties": {
     "component": {
      "const": "Meter"
     },
     "label": {
      "type": "string",
      "maxLength": 200
     },
     "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0 to 100"
     },
     "figure": {
      "type": "string",
      "maxLength": 100
     }
    },
    "required": [
     "component",
     "label",
     "value"
    ],
    "additionalProperties": false
   },
   "ProgressBar": {
    "type": "object",
    "description": "how far along something is",
    "properties": {
     "component": {
      "const": "ProgressBar"
     },
     "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "0 to 100"
     },
     "label": {
      "type": "string",
      "maxLength": 200,
      "description": "shown above the control"
     }
    },
    "required": [
     "component",
     "value"
    ],
    "additionalProperties": false
   },
   "Timeline": {
    "type": "object",
    "description": "steps top to bottom, each with its status",
    "properties": {
     "component": {
      "const": "Timeline"
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string",
         "maxLength": 200
        },
        "status": {
         "enum": [
          "pending",
          "running",
          "done",
          "failed",
          "cancelled"
         ]
        },
        "detail": {
         "type": "string",
         "maxLength": 300
        }
       },
       "required": [
        "label"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "component",
     "steps"
    ],
    "additionalProperties": false
   },
   "MapView": {
    "type": "object",
    "description": "a small offline map: a route and named places, north up, metres to scale",
    "properties": {
     "component": {
      "const": "MapView"
     },
     "route": {
      "type": "array",
      "maxItems": 2000,
      "items": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "prefixItems": [
        {
         "type": "number",
         "minimum": -90,
         "maximum": 90
        },
        {
         "type": "number",
         "minimum": -180,
         "maximum": 180
        }
       ]
      },
      "description": "the route as [latitude, longitude] pairs"
     },
     "places": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
       "type": "object",
       "properties": {
        "lat": {
         "type": "number",
         "minimum": -90,
         "maximum": 90
        },
        "lon": {
         "type": "number",
         "minimum": -180,
         "maximum": 180
        },
        "label": {
         "type": "string",
         "maxLength": 100
        },
        "kind": {
         "enum": [
          "place",
          "finding"
         ]
        }
       },
       "required": [
        "lat",
        "lon"
       ],
       "additionalProperties": false
      }
     },
     "height": {
      "type": "number",
      "minimum": 160,
      "maximum": 600,
      "description": "points"
     }
    },
    "required": [
     "component"
    ],
    "additionalProperties": false
   },
   "Breadcrumbs": {
    "type": "object",
    "description": "where you are, as a trail",
    "properties": {
     "component": {
      "const": "Breadcrumbs"
     },
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
       "type": "string",
       "maxLength": 100
      }
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$",
      "description": "a word reported back to the agent (the render_ui tool's result) when used"
     }
    },
    "required": [
     "component",
     "items"
    ],
    "additionalProperties": false
   },
   "Icon": {
    "type": "object",
    "description": "a Lucide icon by name (\"map-pin\", \"calendar\", \"check\")",
    "properties": {
     "component": {
      "const": "Icon"
     },
     "name": {
      "type": "string",
      "maxLength": 40
     },
     "size": {
      "type": "number",
      "minimum": 12,
      "maximum": 64
     }
    },
    "required": [
     "component",
     "name"
    ],
    "additionalProperties": false
   },
   "Button": {
    "type": "object",
    "description": "a button that reports its action",
    "properties": {
     "component": {
      "const": "Button"
     },
     "label": {
      "type": "string",
      "maxLength": 100
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$",
      "description": "a word reported back to the agent (the render_ui tool's result) when used"
     },
     "style": {
      "enum": [
       "plain",
       "prominent",
       "destructive"
      ]
     },
     "icon": {
      "type": "string",
      "maxLength": 40
     }
    },
    "required": [
     "component",
     "label",
     "action"
    ],
    "additionalProperties": false
   },
   "TextField": {
    "type": "object",
    "description": "a text input that edits the state at bind",
    "properties": {
     "component": {
      "const": "TextField"
     },
     "placeholder": {
      "type": "string",
      "maxLength": 200
     },
     "label": {
      "type": "string",
      "maxLength": 200,
      "description": "shown above the control"
     },
     "bind": {
      "type": "string",
      "pattern": "^(/[A-Za-z0-9_][A-Za-z0-9_-]{0,39}){1,6}$",
      "description": "a JSON pointer into the shared state (\"/form/name\"): the value shown, and where edits go"
     }
    },
    "required": [
     "component",
     "bind"
    ],
    "additionalProperties": false
   },
   "TextArea": {
    "type": "object",
    "description": "a multi-line text input that edits the state at bind",
    "properties": {
     "component": {
      "const": "TextArea"
     },
     "placeholder": {
      "type": "string",
      "maxLength": 200
     },
     "label": {
      "type": "string",
      "maxLength": 200,
      "description": "shown above the control"
     },
     "bind": {
      "type": "string",
      "pattern": "^(/[A-Za-z0-9_][A-Za-z0-9_-]{0,39}){1,6}$",
      "description": "a JSON pointer into the shared state (\"/form/name\"): the value shown, and where edits go"
     },
     "height": {
      "type": "number",
      "minimum": 60,
      "maximum": 400
     }
    },
    "required": [
