--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-macos ]
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - targets:         [ arm64-macos ]
    symbols:         [ _dlsym, _dlopen, _dlclose, _dlerror, _setenv, _time, _dup, _fclose, _fdopen, _fflush, _memcpy, _memmove, _memset, _bzero, _strlen, _write, _posix_memalign, _free, _sin, _cos, ___sincos_stret, _clock_gettime_nsec_np, ___error, _close, _getpid, _lseek, _lstat, _mkdir, _mmap, _munmap, _open, _read, _rename, _stat, _strerror, _unlink, _getenv, _log10, _sysconf, _memset_pattern16, _strtod, _strtod_l, _newlocale, _freelocale, _socket, _connect, _send, _recv, _poll, _fcntl, _getsockopt, _setsockopt, _inet_pton, _getaddrinfo, _freeaddrinfo, _pthread_create, _pthread_detach, _pthread_join, _pthread_attr_init, _pthread_attr_setstacksize, _pthread_attr_destroy, _sched_yield, _pthread_mutex_lock, _pthread_mutex_unlock, _pthread_mutex_destroy, _pthread_cond_signal, _pthread_cond_destroy, _popen, _pclose, _fopen, _fread , _kill, _posix_spawnattr_destroy, _posix_spawnattr_init, _posix_spawnattr_setflags, _posix_spawnattr_setpgroup, _posix_spawn_file_actions_adddup2, _posix_spawn_file_actions_addopen, _posix_spawn_file_actions_destroy, _posix_spawn_file_actions_init, _posix_spawnp, _waitpid]
...
