#!/usr/bin/env bash
# Installs @EX@ for this user: the program in ~/.local/lib/@EX@ (nothing else is kept there), a launcher entry with its icon, and
# ~/.local/bin/@EX@. Running a newer package's install.sh updates it. Remove with: @EX@-uninstall
#
# Two rules (decisions D-8089, D-8093):
#  - It installs the files the packager listed (files.sha256, beside this script), each as it was listed, and nothing else that lies
#    in this folder.
#  - It replaces or removes a file only when the place is on a list it wrote itself (.manifest) and the content is still what that
#    list says; in the layout of before (~/.local/share/@EX@) only when it is byte for byte a file of this package's list. Never a
#    database, nor anything an app keeps what you make in, even if listed. Never through a link.
# Everything is looked at first. What it can't prove to be its own it names; nothing is changed then.
set -euo pipefail
say() { echo "install: $*" >&2; }
stop() { say "$*"; say "nothing was changed"; exit 1; }
for c in sed grep sort cmp cp mv ln mkdir rmdir rm readlink dirname basename sha256sum mktemp cat chmod; do command -v "$c" > /dev/null 2>&1 || stop "this needs the command '$c'"; done
case "$HOME" in /*) ;; *) stop "HOME isn't a folder's full path" ;; esac
[ "$EUID" != 0 ] || [ -z "${SUDO_USER:-}" ] || [ "$SUDO_USER" = root ] || stop "run this without sudo: it installs for the person who runs it"
[ -O "$HOME" ] || stop "HOME ($HOME) isn't yours: run this without sudo, as the person it is for"
case "$HOME" in *$'\n'*) stop "HOME has a line break in it" ;; esac
here="$(cd -P "$(dirname "$0")" && pwd -P)"
dest="$HOME/.local/lib/@EX@"
old="$HOME/.local/share/@EX@"  # (the layout of before: the program beside what you made)
bin="$HOME/.local/bin"
desk=".local/share/applications/@EX@.desktop"
icon=".local/share/icons/hicolor/256x256/apps/@EX@.png"
un=".local/bin/@EX@-uninstall"
manifest="$dest/.manifest"
data=("$old" "$HOME/.config/@EX@")  # where @EX@ keeps what you make and its settings
case "${XDG_DATA_HOME:-}" in /*) data+=("$XDG_DATA_HOME/@EX@") ;; esac
for d in @DATA@; do data+=("$HOME/$d"); done

there() { [ -e "$1" ] || [ -L "$1" ]; }
sum() { local s; s="$(sha256sum < "$1")"; echo "${s%% *}"; }
listed() { [ -n "$mine" ] && grep -qxF -- "$1  $2" <<< "$mine"; }  # listed <sha> <path as the list has it>
kept() {  # a name apps keep what people make under: never installed, never removed
  case "/$1/" in */unsaved/*|*/snaps/*) return 0 ;; esac
  case "$(basename "$1")" in *.db|*.db-*|*-wal|*-shm|*.sqlite|*.sqlite-*) return 0 ;; esac
  return 1
}
plain() { case "$1" in ''|/*|*//*|.|..|./*|../*|*/./*|*/../*|*/.|*/..|"~"*|*$'\n'*|*$'\r'*) return 1 ;; esac; return 0; }  # a path under a folder, written one way
ours() { local s; s="$(sum "$1" 2>/dev/null)" && [ -n "$s" ] && listed "$s" "$2"; }  # the content there is what our list says
inside() {  # <a> is <b>, or lies in it (by what the folders are, not by what they're called)
  local p="$1"
  [ -d "$2" ] || return 1
  while [ ! -d "$p" ]; do [ "$p" != / ] || return 1; p="$(dirname "$p")"; done
  p="$(cd -P "$p" && pwd -P)"
  while :; do [ ! "$p" -ef "$2" ] || return 0; [ "$p" != / ] || return 1; p="$(dirname "$p")"; done
}
way() {  # the folders to <path> can be gone through or made
  local p="$1"
  while ! there "$p"; do p="$(dirname "$p")"; done
  [ -e "$p" ] || stop "$p is a link to nothing"
  [ -d "$p" ] || stop "$p is in the way: it isn't a folder"
  [ -w "$p" ] && [ -x "$p" ] || stop "$p can't be written to"
}
linked() {  # a link among the folders from <root> down to <relative path>'s, the path itself left out
  local d; d="$(dirname "$2")"
  while [ "$d" != . ] && [ "$d" != / ]; do [ ! -L "$1/$d" ] || return 0; d="$(dirname "$d")"; done
  return 1
}
quoted() {  # a program's path in an Exec line (Desktop Entry Specification: in double quotes, \ " ` $ escaped, that once more as a string value is, % doubled)
  printf '"%s"' "$(sed -e 's/\\/\\\\\\\\/g' -e 's/"/\\\\"/g' -e 's/`/\\\\`/g' -e 's/\$/\\\\$/g' -e 's/%/%%/g' <<< "$1")"
}
entry() {  # the launcher entry with this Exec
  printf '[Desktop Entry]\nType=Application\nName=@EX@\nComment=@COMMENT@\nExec=%s %%f\nIcon=@EX@\nTerminal=false\nCategories=@CATS@\nMimeType=@MIME@\n' "$1"
}
old_uninstaller() {  # what the installer of before wrote, word for word (1: with its line about omxc; 0: from before that line)
  printf '#!/usr/bin/env bash\n%s "%s" "%s" "%s" "%s" "%s"\n' 'rm -rf' "$old" "$bin/@EX@" "$HOME/$desk" "$HOME/$icon" "$HOME/$un"
  [ "$1" = 0 ] || printf '[ "$(readlink "%s")" != "%s" ] || rm -f "%s"\n' "$bin/omxc" "$old/omxc" "$bin/omxc"
  printf 'echo "@EX@ removed"\n'
}

# ---------- this package: the files the packager listed, each as listed
[ -f "$here/files.sha256" ] && [ ! -L "$here/files.sha256" ] || stop "this package has no list of its files (files.sha256)"
listing="$(cat "$here/files.sha256")"
[ -n "$listing" ] || stop "this package's list is empty"
files=""; modes=""; new=""
while IFS= read -r l; do  # (<sha256>  <mode> <path>)
  s="${l%%  *}"; f="${l#*  }"; m="${f%% *}"; f="${f#* }"
  case "$s" in *[!0-9a-f]*|'') stop "this package's list isn't one: $l" ;; esac
  case "$m" in 644|755) ;; *) stop "this package's list isn't one: $l" ;; esac
  [ "${#s}" = 64 ] && plain "$f" || stop "this package's list isn't one: $l"
  ! kept "$f" || stop "this package lists $f, a name @EX@ keeps what you make under"
  [ "$f" != .manifest ] && [ "$f" != files.sha256 ] && [ "$f" != install.sh ] || stop "this package lists $f"
  ! linked "$here" "$f" && [ ! -L "$here/$f" ] && [ -f "$here/$f" ] || stop "this package isn't whole: $f isn't there"
  [ "$(sum "$here/$f")" = "$s" ] || stop "this package isn't whole: $f isn't what the packager put there"
  files="$files$f"$'\n'; modes="$modes$m $f"$'\n'; new="$new$s  $f"$'\n'
done <<< "$listing"
files="${files%$'\n'}"; modes="${modes%$'\n'}"; new="${new%$'\n'}"; pack="$new"  # (as a list in .manifest has it, without the modes)
grep -qxF "@EX@" <<< "$files" && grep -qxF "@EX@.png" <<< "$files" || stop "this package isn't whole"

# ---------- everything is looked at; nothing is changed until all of it is in order
for d in "$dest" "${data[@]}"; do
  ! inside "$here" "$d" || stop "this package lies in $d, which is @EX@'s own place: unpack it somewhere else and run its install.sh there"
  ! inside "$d" "$here" || stop "$d lies in this package's folder ($here): unpack the package somewhere else and run its install.sh there"
done
for d in "${data[@]}"; do
  ! inside "$dest" "$d" && ! inside "$d" "$dest" && [ "$d" != "$dest" ] || stop "$dest and $d, where @EX@ keeps what you make, are in one another"
done
[ ! -L "$dest" ] || stop "$dest is a link: the program isn't installed through it"
way "$dest"; way "$bin"; way "$HOME/$(dirname "$desk")"; way "$HOME/$(dirname "$icon")"
mine=""
if there "$manifest"; then
  [ ! -L "$manifest" ] && [ -f "$manifest" ] && [ -r "$manifest" ] || stop "$manifest isn't this program's list"
  mine="$(cat "$manifest")"
fi
while IFS= read -r f; do
  ! linked "$dest" "$f" || stop "a folder on the way to $dest/$f is a link"
  way "$dest/$(dirname "$f")"
  if there "$dest/$f"; then
    [ ! -L "$dest/$f" ] && [ -f "$dest/$f" ] || stop "$dest/$f is in the way: it isn't a file of this program's"
    if ! cmp -s -- "$here/$f" "$dest/$f" && ! ours "$dest/$f" "$f"; then
      [ -n "$mine" ] || stop "$dest/$f isn't this package's, and the list of what was installed there ($manifest) is gone. The folder holds only the program: move $dest away and run this again"
      stop "$dest/$f isn't what this program's installer wrote"
    fi
  fi
done <<< "$files"
for n in @EX@ omxc; do
  grep -qxF "$n" <<< "$files" || continue
  if there "$bin/$n"; then
    case "$(readlink "$bin/$n" || true)" in "$dest/$n"|"$old/$n") ;; *) stop "$bin/$n isn't this program's" ;; esac
  fi
done
# (the launcher entry and the uninstaller as this package writes them)
half=""
work="$(mktemp -d)"; trap 'rm -f -- "${work:?}/desk" "${work:?}/un" "${work:?}/list"; rmdir -- "${work:?}"; if [ -n "$half" ]; then rm -f -- "${half:?}"; fi' EXIT
entry "$(quoted "$dest/@EX@")" > "$work/desk"
cat > "$work/un" <<'UN'
#!/usr/bin/env bash
# Removes the program @EX@: the files its installer wrote, each only if its place is on the installer's list and its content is
# still what the list says. What you made with it stays, wherever it is.
set -euo pipefail
dest="${HOME:?}/.local/lib/@EX@"; bin="${HOME:?}/.local/bin"
if [ ! -f "$dest/.manifest" ] || [ -L "$dest/.manifest" ] || [ -L "$dest" ]; then
  echo "the list of what was installed ($dest/.manifest) is gone: nothing was removed. $dest holds only the program." >&2; exit 1
fi
linked() { local d; d="$(dirname "$2")"; while [ "$d" != . ] && [ "$d" != / ]; do [ ! -L "$1/$d" ] || return 0; d="$(dirname "$d")"; done; return 1; }
kept() { case "/$1/" in */unsaved/*|*/snaps/*) return 0 ;; esac; case "$(basename "$1")" in *.db|*.db-*|*-wal|*-shm|*.sqlite|*.sqlite-*) return 0 ;; esac; return 1; }
left=""
list="$(cat "$dest/.manifest")"
for n in @EX@ omxc; do if [ "$(readlink "$bin/$n" 2>/dev/null || true)" = "$dest/$n" ]; then rm -f -- "${bin:?}/${n:?}"; fi; done
while IFS= read -r l; do
  s="${l%%  *}"; f="${l#*  }"; root="$dest"
  case "$f" in
    "~/.local/share/applications/@EX@.desktop"|"~/.local/share/icons/hicolor/256x256/apps/@EX@.png"|"~/.local/bin/@EX@-uninstall") root="${HOME:?}"; f="${f#\~/}" ;;
    ''|/*|*//*|.|..|./*|../*|*/./*|*/../*|*/.|*/..|"~"*) continue ;;
    *) if linked "$dest" "$f"; then continue; fi ;;
  esac
  if kept "$f"; then continue; fi
  if [ ! -f "$root/$f" ] || [ -L "$root/$f" ]; then continue; fi
  h="$(sha256sum < "$root/$f" 2>/dev/null || true)"; h="${h%% *}"
  if [ "$h" != "$s" ]; then grep -qxF -- "$h  ${l#*  }" <<< "$list" || left="$left $root/$f"; continue; fi
  rm -f -- "${root:?}/${f:?}"
  if [ "$root" = "$dest" ]; then d="$(dirname "$f")"; while [ "$d" != . ] && [ "$d" != / ]; do rmdir -- "${dest:?}/${d:?}" 2>/dev/null || break; d="$(dirname "$d")"; done; fi
done <<< "$list"
rm -f -- "${dest:?}/.manifest"
rmdir -- "${dest:?}" 2>/dev/null || echo "$dest holds files that aren't what the installer wrote: left there"
[ -z "$left" ] || echo "changed since it was installed, left there:$left"
echo "@EX@ removed. What you made with it is where it was."
UN
chmod 644 "$work/desk"; chmod 755 "$work/un"
put_desk=1; put_icon=1
if there "$HOME/$desk"; then  # (an entry changed, or made by hand, is the person's, whatever it starts)
  if [ -L "$HOME/$desk" ] || [ ! -f "$HOME/$desk" ]; then put_desk=0
  elif ! ours "$HOME/$desk" "~/$desk" && ! cmp -s -- "$work/desk" "$HOME/$desk" && ! cmp -s -- <(entry "$old/@EX@") "$HOME/$desk"; then put_desk=0; fi
fi
if there "$HOME/$icon"; then
  if [ -L "$HOME/$icon" ] || [ ! -f "$HOME/$icon" ]; then put_icon=0
  elif ! ours "$HOME/$icon" "~/$icon" && ! cmp -s -- "$here/@EX@.png" "$HOME/$icon" && { [ -L "$old/@EX@.png" ] || [ ! -f "$old/@EX@" ] || ! cmp -s -- "$old/@EX@.png" "$HOME/$icon"; }; then put_icon=0; fi
fi
by_old=0  # (an installer of before put the program of the old layout there: its uninstaller is there, word for word)
if there "$HOME/$un"; then
  [ ! -L "$HOME/$un" ] && [ -f "$HOME/$un" ] || stop "$HOME/$un isn't this program's"
  if cmp -s -- <(old_uninstaller 1) "$HOME/$un" || cmp -s -- <(old_uninstaller 0) "$HOME/$un"; then by_old=1; fi
  [ "$by_old" = 1 ] || ours "$HOME/$un" "~/$un" || cmp -s -- "$work/un" "$HOME/$un" || stop "$HOME/$un isn't this program's"
fi

# ---------- in order: the new one in, file by file (each whole or not at all), by its list
[ "$put_desk" = 0 ] || new="$new"$'\n'"$(sum "$work/desk")  ~/$desk"
[ "$put_icon" = 0 ] || new="$new"$'\n'"$(sum "$here/@EX@.png")  ~/$icon"
new="$new"$'\n'"$(sum "$work/un")  ~/$un"
mkdir -p "$dest" "$bin" "$HOME/$(dirname "$desk")" "$HOME/$(dirname "$icon")"
put() { half="$(mktemp "$2.XXXXXX")"; cp -p -- "$1" "$half"; chmod "$3" -- "$half"; mv -f -- "$half" "$2"; half=""; }  # (a file of a new name, renamed over: never written into, nor through a link)
printf '%s\n%s\n' "$mine" "$new" | grep -v '^$' | LC_ALL=C sort -u > "$work/list"; put "$work/list" "$manifest" 644  # (both lists while it changes over: cut short, the next run and the uninstaller know all of it)
while IFS= read -r l; do m="${l%% *}"; f="${l#* }"; mkdir -p "$(dirname "$dest/$f")"; put "$here/$f" "$dest/$f" "$m"; done <<< "$modes"  # (a mode as listed: a copy over exFAT or a cloud folder has none)
if [ "$put_icon" = 1 ]; then put "$here/@EX@.png" "$HOME/$icon" 644; else say "$HOME/$icon isn't what this program's installer wrote: it is left as it is"; fi
if [ "$put_desk" = 1 ]; then put "$work/desk" "$HOME/$desk" 644; else say "$HOME/$desk isn't what this program's installer wrote: it is left as it is (the program is $dest/@EX@)"; fi
put "$work/un" "$HOME/$un" 755
for n in @EX@ omxc; do if grep -qxF "$n" <<< "$files"; then ln -sfn -- "$dest/$n" "$bin/$n"; fi; done  # (omxc: omxconsole's command line for agents, D-6502)
# what only the one before had goes: in its list, and still as it was written
while IFS= read -r l; do
  s="${l%%  *}"; f="${l#*  }"
  if ! plain "$f" || kept "$f" || grep -qxF -- "$f" <<< "$files" || linked "$dest" "$f" || [ -L "$dest/$f" ] || [ ! -f "$dest/$f" ]; then continue; fi
  if [ "$(sum "$dest/$f" 2>/dev/null || true)" = "$s" ]; then
    rm -f -- "${dest:?}/${f:?}"
    d="$(dirname "$f")"; while [ "$d" != . ] && [ "$d" != / ]; do rmdir -- "${dest:?}/${d:?}" 2>/dev/null || break; d="$(dirname "$d")"; done
  fi
done <<< "$mine"
printf '%s\n' "$new" > "$work/list"; put "$work/list" "$manifest" 644

# the layout of before: taken apart only when an installer put it there (its uninstaller was there) and every file of it that is on this
# package's list is byte for byte that one: all of them or none. Everything else stays. Not when a launcher entry that was left may
# start it there
same_there() { plain "$1" && ! kept "$1" && [ -f "$old/$1" ] && [ ! -L "$old/$1" ] && ! linked "$old" "$1" && [ "$(sum "$old/$1" 2>/dev/null || true)" = "$2" ]; }
apart="$by_old"; [ "$put_desk" = 1 ] && [ -d "$old" ] && [ ! -L "$old" ] && [ -f "$old/@EX@" ] || apart=0
if [ "$apart" = 1 ]; then
  while IFS= read -r l; do
    s="${l%%  *}"; f="${l#*  }"
    if there "$old/$f" && ! same_there "$f" "$s"; then apart=0; fi
  done <<< "$pack"
fi
if [ "$apart" = 1 ]; then
  while IFS= read -r l; do
    s="${l%%  *}"; f="${l#*  }"
    if same_there "$f" "$s"; then
      rm -f -- "${old:?}/${f:?}"
      d="$(dirname "$f")"; while [ "$d" != . ] && [ "$d" != / ]; do rmdir -- "${old:?}/${d:?}" 2>/dev/null || break; d="$(dirname "$d")"; done
    fi
  done <<< "$pack"
fi
if [ -f "$old/@EX@" ] && [ ! -L "$old" ]; then
  was="a program is in $old too"; [ "$by_old" = 0 ] || was="an older program is still in $old"
  if [ "$put_desk" = 1 ]; then say "$was (left as it is): your app launcher and $bin/@EX@ start the one in $dest"; else say "$was (left as it is): the launcher entry may start it; $bin/@EX@ starts the one in $dest"; fi
fi
if [ "$put_desk" = 1 ]; then say "done. Open it from your app launcher, or run: @EX@"; else say "done. Run: @EX@"; fi
