diff --git a/mojo/omxcore/_libc.mojo b/mojo/omxcore/_libc.mojo
new file mode 100644
index 0000000..2db5901
--- /dev/null
+++ b/mojo/omxcore/_libc.mojo
@@ -0,0 +1,101 @@
+"""The libc functions the engine calls through a pointer instead of declaring them.
+
+Mojo allows one signature per external symbol in a binary. Mojo 1.2's stdlib declares `read` and `write` itself, and
+the libraries an app links beside the engine (Flare, its json, the apps' mojoui) declare pthread_create, strtod, mmap
+and others with their own types, so an engine declaration of any of them breaks that app's build ("existing function
+with conflicting signature"). Looked up with dlsym and called through a typed pointer, the engine declares none of
+them and builds beside any of those. dlsym itself is declared as the apps' mojoui declares it. A lookup costs about a
+hash probe: none of these is on a per-row path. A function libc doesn't have (dlsym gives 0) is never called: each
+wrapper returns the C function's own failure value instead (-1, or NaN for strtod)."""
+from std.ffi import external_call, c_int
+from std.memory import Pointer
+from std.sys import CompilationTarget
+from std.memory.alloc import unsafe_alloc
+
+comptime ThreadEntry = def(Int) thin abi("C") -> Int
+"""A thread's start routine: the argument is an address, the result is ignored."""
+
+
+def _sym(name: String) -> Int:
+    var n = name
+    var anywhere = -2 if CompilationTarget.is_macos() else 0  # RTLD_DEFAULT
+    return external_call["dlsym", Int](anywhere, n.as_c_string_span())
+
+
+def pthread_create(attr: Int, entry: ThreadEntry, arg: Int) -> Tuple[c_int, Int]:
+    """(pthread_create's result, the new thread's id). `attr`: a pthread_attr_t's address (0: defaults). The id is
+    written into memory of this function's own and read back here: handed the address of a caller's local as an Int,
+    the compiler could keep using the local's old value (the engine's fan joined thread 0 and crashed). Guard: the
+    engine's test_switches_threads (a save's fan joins every thread it started) and mojo_test.sh's job tests."""
+    var f = _sym("pthread_create")
+    if f == 0:
+        return (c_int(-1), 0)
+    var cell = unsafe_alloc[Int](1)
+    cell[0] = 0
+    var rc = Pointer(to=f).unsafe_bitcast[def(Int, Int, ThreadEntry, Int) thin abi("C") -> c_int]()[](Int(cell), attr, entry, arg)
+    var tid = cell[0]
+    cell.free()
+    return (rc, tid)
+
+
+def pthread_join(tid: Int) -> c_int:
+    var f = _sym("pthread_join")
+    if f == 0:
+        return c_int(-1)
+    return Pointer(to=f).unsafe_bitcast[def(Int, Int) thin abi("C") -> c_int]()[](tid, 0)
+
+
+def pthread_detach(tid: Int) -> c_int:
+    var f = _sym("pthread_detach")
+    if f == 0:
+        return c_int(-1)
+    return Pointer(to=f).unsafe_bitcast[def(Int) thin abi("C") -> c_int]()[](tid)
+
+
+def strtod(text: Int) -> Float64:
+    """`text`: the address of a NUL-terminated number in the process locale."""
+    var f = _sym("strtod")
+    if f == 0:
+        return Float64(0) / Float64(0)
+    return Pointer(to=f).unsafe_bitcast[def(Int, Int) thin abi("C") -> Float64]()[](text, 0)
+
+
+def read(fd: Int, buf: Int, count: Int) -> Int:
+    var f = _sym("read")
+    if f == 0:
+        return -1
+    return Pointer(to=f).unsafe_bitcast[def(c_int, Int, Int) thin abi("C") -> Int]()[](c_int(fd), buf, count)
+
+
+def write(fd: Int, buf: Int, count: Int) -> Int:
+    var f = _sym("write")
+    if f == 0:
+        return -1
+    return Pointer(to=f).unsafe_bitcast[def(c_int, Int, Int) thin abi("C") -> Int]()[](c_int(fd), buf, count)
+
+
+def mmap(addr: Int, length: Int, prot: Int, flags: Int, fd: Int, offset: Int) -> Int:
+    """The mapping's address, or -1 (MAP_FAILED)."""
+    var f = _sym("mmap")
+    if f == 0:
+        return -1
+    return Pointer(to=f).unsafe_bitcast[def(Int, Int, c_int, c_int, c_int, Int) thin abi("C") -> Int]()[](
+        addr, length, c_int(prot), c_int(flags), c_int(fd), offset)
+
+
+def munmap(addr: Int, length: Int) -> c_int:
+    var f = _sym("munmap")
+    if f == 0:
+        return c_int(-1)
+    return Pointer(to=f).unsafe_bitcast[def(Int, Int) thin abi("C") -> c_int]()[](addr, length)
+
+
+def unlink(path: String) -> c_int:
+    var p = path
+    var f = _sym("unlink")
+    if f == 0:
+        return c_int(-1)
+    var at = Int(p.as_c_string_span().unsafe_ptr())
+    var rc = Pointer(to=f).unsafe_bitcast[def(Int) thin abi("C") -> c_int]()[](at)
+    _ = p^
+    return rc
