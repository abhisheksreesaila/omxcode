   "a": [
    1,
    2
   ]
  },
  "error": "out of range",
  "patch": [
   {
    "op": "add",
    "path": "/a/3",
    "value": 3
   }
  ]
 },
 {
  "comment": "an index with a leading zero",
  "doc": {
