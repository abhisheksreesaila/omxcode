[
 {
  "comment": "A.1 adding an object member",
  "doc": {
   "foo": "bar"
  },
  "patch": [
   {
    "op": "add",
    "path": "/baz",
    "value": "qux"
   }
  ],
  "expected": {
   "baz": "qux",
   "foo": "bar"
  }
 },
 {
  "comment": "A.2 adding an array element",
  "doc": {
   "foo": [
    "bar",
    "baz"
   ]
  },
  "patch": [
   {
    "op": "add",
    "path": "/foo/1",
    "value": "qux"
   }
  ],
  "expected": {
   "foo": [
    "bar",
    "qux",
    "baz"
   ]
  }
 },
 {
  "comment": "A.3 removing an object member",
  "doc": {
   "baz": "qux",
   "foo": "bar"
  },
  "patch": [
   {
    "op": "remove",
    "path": "/baz"
   }
  ],
  "expected": {
   "foo": "bar"
  }
 },
 {
  "comment": "A.4 removing an array element",
  "doc": {
   "foo": [
    "bar",
    "qux",
    "baz"
   ]
  },
  "patch": [
   {
    "op": "remove",
    "path": "/foo/1"
   }
  ],
  "expected": {
   "foo": [
    "bar",
    "baz"
   ]
  }
 },
 {
  "comment": "A.5 replacing a value",
  "doc": {
   "baz": "qux",
   "foo": "bar"
  },
  "patch": [
   {
    "op": "replace",
    "path": "/baz",
    "value": "boo"
   }
  ],
  "expected": {
   "baz": "boo",
   "foo": "bar"
  }
 },
 {
  "comment": "A.6 moving a value",
  "doc": {
   "foo": {
    "bar": "baz",
    "waldo": "fred"
   },
   "qux": {
    "corge": "grault"
   }
  },
  "patch": [
   {
    "op": "move",
    "from": "/foo/waldo",
    "path": "/qux/thud"
   }
  ],
  "expected": {
   "foo": {
    "bar": "baz"
   },
   "qux": {
    "corge": "grault",
    "thud": "fred"
   }
  }
 },
 {
  "comment": "A.7 moving an array element",
  "doc": {
   "foo": [
    "all",
    "grass",
    "cows",
    "eat"
   ]
  },
  "patch": [
   {
    "op": "move",
    "from": "/foo/1",
    "path": "/foo/3"
   }
  ],
  "expected": {
   "foo": [
    "all",
    "cows",
    "eat",
    "grass"
   ]
  }
 },
 {
  "comment": "A.8 testing a value: success",
  "doc": {
   "baz": "qux",
   "foo": [
    "a",
    2,
    "c"
   ]
  },
  "patch": [
   {
    "op": "test",
    "path": "/baz",
    "value": "qux"
   },
   {
    "op": "test",
    "path": "/foo/1",
    "value": 2
   }
  ],
  "expected": {
   "baz": "qux",
   "foo": [
    "a",
    2,
    "c"
   ]
  }
 },
 {
  "comment": "A.9 testing a value: error",
  "doc": {
   "baz": "qux"
  },
  "error": "test failed",
  "patch": [
   {
    "op": "test",
    "path": "/baz",
    "value": "bar"
   }
  ]
 },
 {
  "comment": "A.10 adding a nested member object",
  "doc": {
   "foo": "bar"
  },
  "patch": [
   {
    "op": "add",
    "path": "/child",
    "value": {
     "grandchild": {}
    }
   }
  ],
  "expected": {
   "foo": "bar",
   "child": {
    "grandchild": {}
   }
  }
 },
 {
  "comment": "A.11 ignoring unrecognized elements",
  "doc": {
   "foo": "bar"
  },
  "patch": [
   {
    "op": "add",
    "path": "/baz",
    "value": "qux",
    "xyz": 123
   }
  ],
  "expected": {
   "foo": "bar",
   "baz": "qux"
  }
 },
 {
  "comment": "A.12 adding to a nonexistent target",
  "doc": {
   "foo": "bar"
  },
  "error": "no parent",
  "patch": [
   {
    "op": "add",
    "path": "/baz/bat",
    "value": "qux"
   }
  ]
 },
 {
  "comment": "A.13 invalid JSON Patch document (op twice)",
  "doc": {
   "foo": "bar"
  },
  "error": "op twice",
  "patch_text": "[{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"op\": \"remove\"}]"
 },
 {
  "comment": "A.14 ~ escape ordering",
  "doc": {
   "/": 9,
   "~1": 10
  },
  "patch": [
   {
    "op": "test",
    "path": "/~01",
    "value": 10
   }
  ],
  "expected": {
   "/": 9,
   "~1": 10
  }
 },
 {
  "comment": "A.15 comparing strings and numbers",
  "doc": {
   "/": 9,
   "~1": 10
  },
  "error": "test failed",
  "patch": [
   {
    "op": "test",
    "path": "/~01",
    "value": "10"
   }
  ]
 },
 {
  "comment": "A.16 adding an array value",
  "doc": {
   "foo": [
    "bar"
   ]
  },
  "patch": [
   {
    "op": "add",
    "path": "/foo/-",
    "value": [
     "abc",
     "def"
    ]
   }
  ],
  "expected": {
   "foo": [
    "bar",
    [
     "abc",
     "def"
    ]
   ]
  }
 },
 {
  "comment": "replace the whole document",
  "doc": {
   "a": 1
  },
  "patch": [
   {
    "op": "replace",
    "path": "",
    "value": [
     1,
     2
    ]
   }
  ],
  "expected": [
   1,
   2
  ]
 },
 {
