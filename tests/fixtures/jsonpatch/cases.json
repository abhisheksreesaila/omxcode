 },
 {
  "comment": "nested arrays and state-like deltas",
  "doc": {
   "rows": [
    [
     1,
     2
    ],
    [
     3,
     4
    ]
   ],
   "meta": {
    "n": 2
   }
  },
  "patch": [
   {
    "op": "add",
    "path": "/rows/-",
    "value": [
     5,
     6
    ]
   },
   {
    "op": "replace",
    "path": "/meta/n",
    "value": 3
   },
   {
    "op": "remove",
    "path": "/rows/0/1"
   }
  ],
  "expected": {
   "rows": [
    [
     1
    ],
    [
     3,
     4
    ],
    [
     5,
     6
    ]
   ],
   "meta": {
    "n": 3
   }
  }
 },
 {
  "comment": "a pointer without its leading slash",
