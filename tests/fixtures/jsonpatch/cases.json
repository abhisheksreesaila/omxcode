 },
 {
  "comment": "numbers, null and booleans keep their values",
  "doc": {
   "x": null
  },
  "patch": [
   {
    "op": "add",
    "path": "/y",
    "value": [
     -2.5,
     0,
     1000.0,
     true,
     false,
     null
    ]
   }
  ],
  "expected": {
   "x": null,
   "y": [
    -2.5,
    0,
    1000.0,
    true,
    false,
    null
   ]
  }
 }
