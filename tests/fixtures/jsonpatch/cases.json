  },
  "error": "missing",
  "patch": [
   {
    "op": "remove",
    "path": "/b"
   }
  ]
 },
 {
  "comment": "move a value into itself",
  "doc": {
   "a": {
    "b": 1
   }
  },
  "error": "into itself",
  "patch": [
   {
    "op": "move",
    "from": "/a",
    "path": "/a/b/c"
   }
  ]
 },
 {
  "comment": "copy, then change the copy",
  "doc": {
   "a": {
    "x": 1
   }
  },
  "patch": [
   {
    "op": "copy",
    "from": "/a",
    "path": "/b"
   },
   {
    "op": "replace",
    "path": "/b/x",
    "value": 2
   }
  ],
  "expected": {
   "a": {
    "x": 1
   },
   "b": {
    "x": 2
   }
  }
 },
 {
  "comment": "test objects whatever their order",
  "doc": {
   "o": {
    "a": 1,
    "b": [
     true,
     null
    ]
   }
  },
  "patch": [
   {
    "op": "test",
    "path": "/o",
    "value": {
     "b": [
      true,
      null
     ],
     "a": 1
    }
   }
  ],
  "expected": {
   "o": {
    "a": 1,
    "b": [
     true,
     null
    ]
   }
  }
 },
 {
