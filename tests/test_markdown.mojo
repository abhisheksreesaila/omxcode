# mojoui.markdown (goal 33 M4): the notebook's markdown parsed as the original console parses it (blade-notebook.js),
# against the recorded notebook (docs/goals/33/fixtures/admin_learn_qwen2.5-0.5b.json) and a corpus of edge cases;
# unsafe input stays text; the view's roles and inline pieces.
#   scripts/mxbuild.sh tests/test_markdown.mojo -o build/test_markdown && build/test_markdown
from std.testing import assert_equal, assert_true, assert_false
from mojoui.json import Json
from mojoui.view import View, TEXT, HSTACK, BUTTON, PARAGRAPH
from mojoui.markdown import (Run, Block, Chapter, parse_markdown, parse_inline, plain_text, chapters, safe_url,
                             Markdown, markdown_roles, nbsp, MD_P, MD_HEADING, MD_UL, MD_OL, MD_CODE)
from mojoui.paragraph import runs_of
from mojoui.theme import Palette


def code(t: String, href: String = "") -> Run:
    return Run(t, False, False, True, href)


def bold(t: String) -> Run:
    return Run(t, True, False, False, "")


def runs_eq(got: List[Run], want: List[Run], what: String) raises:
    var g = String("")
    var w = String("")
    for r in got:
        g += String(r)
    for r in want:
        w += String(r)
    assert_equal(g, w, what)


def only_text(src: String, what: String) raises:
    """`src` comes back as one paragraph holding exactly its own text, unstyled and not a link."""
    var b = parse_markdown(src)
    assert_equal(len(b), 1, what)
    assert_equal(b[0].kind, MD_P, what)
    runs_eq(b[0].spans, [Run(src)], what)


def texts(v: View, tag: String) -> List[String]:
    """The words wearing role `tag`: a Text's, a Paragraph's (all its words), or a Paragraph's run's."""
    var out = List[String]()
    for n in v.nodes:
        if (n.kind == TEXT or n.kind == PARAGRAPH) and n.name == tag:
            out.append(n.text)
        if n.kind == PARAGRAPH:
            for r in runs_of(n):
                if r.role == tag and r.role != n.name:
                    out.append(r.text)
    return out^


def notebook() raises:
    var j = Json.parse(open("docs/goals/33/fixtures/admin_learn_qwen2.5-0.5b.json", "r").read())
    var cells = j.get(0, "cells")
    var sources = List[String]()
    var md = List[Bool]()
    for k in range(j.size(cells)):
        var c = j.at(cells, k)
        sources.append(j.text(j.get(c, "source")))
        md.append(j.text(j.get(c, "type")) == "markdown")
    assert_equal(len(sources), 13)

    # cell 0: a title, a paragraph with a code link and inline code, a list with bold labels
    var b = parse_markdown(sources[0])
    assert_equal(len(b), 4)
    assert_equal(b[0].kind, MD_HEADING)
    assert_equal(b[0].level, 1)
    assert_equal(plain_text(b[0].spans), "qwen2.5-0.5b")
    assert_equal(b[1].kind, MD_P)
    runs_eq(b[1].spans, [code("Qwen/Qwen2.5-0.5B-Instruct", "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct"),
                         Run(" on Hugging Face. Everything below came from the Hugging Face API and was generated by "),
                         code("mxc learn"), Run(".")], "cell 0's paragraph")
    assert_equal(b[2].level, 2)
    assert_equal(plain_text(b[2].spans), "What it is")
    assert_equal(b[3].kind, MD_UL)
    assert_equal(len(b[3].items), 6)
    runs_eq(b[3].items[0], [bold("Pipeline:"), Run(" text-generation")], "the first item")
    runs_eq(b[3].items[5], [bold("Revision:"), Run(" 7ae5576")], "the last item")

    # cell 1: two headings of different levels in one cell
    var c1 = parse_markdown(sources[1])
    assert_equal(len(c1), 7)
    assert_equal(c1[1].level, 1)
    assert_equal(plain_text(c1[1].spans), "Qwen2.5-0.5B-Instruct")

    # cell 2: a table is not markdown here: it stays one paragraph of its lines, its `code` styled
    var c2 = parse_markdown(sources[2])
    assert_equal(len(c2), 3)
    runs_eq(c2[1].spans, [Run("From "), code("config.json"), Run(":")], "From config.json")
    assert_equal(c2[2].kind, MD_P)
    var table = plain_text(c2[2].spans)
    assert_true(table.startswith("| field | value | what it means | |---|---|---| | model_type | qwen2 |"), String(table[byte = : 90]))
    assert_true(c2[2].spans[1].code and c2[2].spans[1].text == "model_type")

    # cell 3: **bold** inside the table's text
    var found = False
    for r in parse_markdown(sources[3])[2].spans:
        if r.bold and r.text == "estimated total":
            found = True
    assert_true(found, "**estimated total** is bold")

    # cell 4: a list item that is all code (a path with underscores stays whole)
    var c4 = parse_markdown(sources[4])
    assert_equal(c4[2].kind, MD_UL)
    assert_equal(len(c4[2].items[0]), 1)
    assert_true(c4[2].items[0][0].code and c4[2].items[0][0].text.endswith("/architectures/qwen2"))

    # the chapters, as the recorded shot lists them
    var ch = chapters(sources, md)
    var want: List[String] = ["qwen2.5-0.5b", "What it is", "Model card", "Qwen2.5-0.5B-Instruct", "Quickstart", "Evaluation",
                              "Architecture", "Where the parameters live", "See inside: MAX's implementation", "Try it"]
    var levels: List[Int] = [1, 2, 2, 1, 2, 2, 2, 2, 2, 2]
    var cellof: List[Int] = [0, 0, 1, 1, 1, 1, 2, 3, 4, 5]
    assert_equal(len(ch), 10)
    for k in range(10):
        assert_equal(ch[k].title, want[k])
        assert_equal(ch[k].level, levels[k])
        assert_equal(ch[k].cell, cellof[k])

    # the view: roles and pieces
    var v = Markdown(sources[0])
    assert_equal(v.nodes[0].name, "markdown")
    assert_equal(texts(v, "md-h1")[0], "qwen2.5-0.5b")
    assert_equal(texts(v, "md-h2")[0], "What it is")
    assert_equal(texts(v, "md-code-link")[0], "Qwen/Qwen2.5-0.5B-Instruct")
    assert_equal(texts(v, "md-code")[0], "mxc learn")
    assert_equal(len(texts(v, "md-bullet")), 6)
    assert_equal(texts(v, "md-bullet")[0], "•")
    var strong_ok = False
    var link_ok = False
    for n in v.nodes:
        if n.kind != PARAGRAPH:
            continue
        for r in runs_of(n):
            if r.role == "md-strong" and r.text == "Pipeline:":
                strong_ok = r.bold
            if r.role == "md-code-link":
                link_ok = r.code and r.href == "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct"
    assert_true(strong_ok, "bold runs are bold and wear md-strong")
    assert_true(link_ok, "a code link is code with its href")
    var li = texts(v, "md-li")
    assert_true(len(li) > 0 and li[0] == "Pipeline: text-generation", "a list item is one paragraph: its words as written (the host wraps them)")
    for n in v.nodes:  # (no line is broken by Mojo: every block is one Paragraph the host wraps)
        assert_true(n.name != "md-line", "no md-line rows")


def corpus() raises:
    # unsafe input stays text
    only_text("<script>alert('x')</script>", "a script tag")
    only_text("<img src=x onerror=alert(1)>", "an img tag")
    only_text("[x](javascript:alert(1))", "a javascript: link")
    only_text("[x](data:text/html,<b>hi</b>)", "a data: link")
    only_text("[x](/relative/path)", "a relative link")
    only_text("[x](ftp://example.com/a)", "an ftp link")
    only_text("[x](http:///nohost)", "a link with no host")
    only_text("<a href=\"https://e.com\">e</a>", "an a tag")
    var s = Markdown("<script>alert(1)</script>")
    assert_equal(texts(s, "md-p")[0], "<script>alert(1)</script>")
    assert_equal(safe_url("HTTPS://E.com/A?b=1"), "https://e.com/A?b=1")
    assert_equal(safe_url("https://e.com"), "https://e.com/")
    assert_equal(safe_url("https://e.com?q#f"), "https://e.com/?q#f")
    assert_equal(safe_url("javascript:alert(1)"), "")
    assert_equal(safe_url("https://e.com/<x>"), "")
    # a link's text keeps its own styling; a bad link inside bold stays bold text
    runs_eq(parse_inline("[**a** b](https://e.com)"), [Run("a", True, False, False, "https://e.com/"), Run(" b", False, False, False, "https://e.com/")], "styled link text")
    runs_eq(parse_inline("**see [x](javascript:y)**"), [bold("see [x](javascript:y)")], "bad link in bold")

    # inline
    runs_eq(parse_inline("**a _b_ c**"), [bold("a "), Run("b", True, True, False, ""), bold(" c")], "italic in bold")
    runs_eq(parse_inline("**a *b* c**"), [Run("*"), Run("a ", False, True, False, ""), Run("b* c**")], "a star can't nest in ** (as the original's regex)")
    runs_eq(parse_inline("__b__ and _i_"), [bold("b"), Run(" and "), Run("i", False, True, False, "")], "underscores")
    only_text("snake_case_name and a_b_c", "underscores inside words")
    only_text("a * b * c", "a star before a space")
    runs_eq(parse_inline("`a` `b`"), [code("a"), Run(" "), code("b")], "two code runs stay apart")
    only_text("`never closed", "an unclosed backtick")
    var long = String("`")
    for _ in range(600):
        long += "x"
    long += "`"
    only_text(long, "a code run over 500 characters")
    var ok = String("`")
    for _ in range(500):
        ok += "é"  # (characters, not bytes: 500 é is 1,000 bytes and still code)
    ok += "`"
    assert_true(parse_inline(ok)[0].code, "500 characters of é are code")

    # headings
    var h = parse_markdown("# Title ##\n## C#\n####### seven\n#nospace")
    assert_equal(len(h), 3)
    assert_equal(plain_text(h[0].spans), "Title")
    assert_equal(plain_text(h[1].spans), "C#")
    assert_equal(h[2].kind, MD_P)
    assert_equal(plain_text(h[2].spans), "####### seven #nospace")

    # fences: a language, an unclosed one runs to the end, tildes, the inside is never markdown
    var f = parse_markdown("```python\nprint(1)\n# not a heading\n```\nafter")
    assert_equal(len(f), 2)
    assert_equal(f[0].kind, MD_CODE)
    assert_equal(f[0].lang, "python")
    assert_equal(f[0].code, "print(1)\n# not a heading")
    assert_equal(plain_text(f[1].spans), "after")
    var u = parse_markdown("~~~\n<b>x</b>\n\nmore")
    assert_equal(len(u), 1)
    assert_equal(u[0].code, "<b>x</b>\n\nmore")
    assert_equal(u[0].lang, "")

    # lists: numbered, continuation lines, a change of kind starts a new list, CRLF
    var l = parse_markdown("1. one\n2) two\n   more\n- dash\n+ plus\r\n\r\npara")
    assert_equal(len(l), 3)
    assert_equal(l[0].kind, MD_OL)
    assert_equal(len(l[0].items), 2)
    assert_equal(plain_text(l[0].items[1]), "two more")
    assert_equal(l[1].kind, MD_UL)
    assert_equal(len(l[1].items), 2)
    assert_equal(plain_text(l[2].spans), "para")
    var p = parse_markdown("a line\n- not joined, a list\nnext")
    assert_equal(len(p), 3)  # (an unindented line after a list is a new paragraph)
    assert_equal(plain_text(p[0].spans), "a line")
    assert_equal(plain_text(p[2].spans), "next")
    assert_equal(plain_text(p[1].items[0]), "not joined, a list")
    assert_equal(len(parse_markdown("")), 0)
    assert_equal(len(parse_markdown("\n  \n\t\n")), 0)

    var o = Markdown("1. a\n2. b")
    assert_equal(texts(o, "md-bullet")[1], "2.")
    var c = Markdown("```\nx = 1\n    y\n```")
    var lines_at = -1
    for i in range(len(c.nodes)):
        if c.nodes[i].name == "md-pre-text":
            lines_at = i
    assert_true(lines_at > 0 and c.nodes[lines_at - 1].name == "md-pre", "a code block: its lines in the md-pre box")
    assert_equal(len(c.nodes[lines_at].children), 2)
    assert_equal(c.nodes[c.nodes[lines_at].children[0]].text, "x = 1")
    assert_equal(c.nodes[c.nodes[lines_at].children[1]].text, nbsp() + nbsp() + nbsp() + nbsp() + "y", "indent kept")
    for n in c.nodes:
        assert_true(n.kind != BUTTON, "no Copy button: the notebook's pre has none")

    # the roles a theme adds
    var roles = markdown_roles(Palette.plain(), "Geist Mono")
    assert_equal(roles[0].role, "md-h1")
    assert_equal(roles[0].font_size, 20.0)


def main() raises:
    notebook()
    corpus()
    print("markdown: ok")
