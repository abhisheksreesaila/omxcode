# omxplorer's hosted copy (goal 62, docs/web-public.md): the web host in public mode with the robot starter baked in,
# CPU only. Built from the folder scripts/stage-web makes (this repo at its last commit, plus build/starter/robot as
# starter/, plus this file as Dockerfile); scripts/image-check builds and plays the story against it, and
# scripts/deploy-railway sends it to Railway. Listens on $PORT (8080 if unset), answers GET /health, logs on stdout.
# Runs as a user that owns nothing in /app or /data (app and data read-only); it writes only under /tmp.

# ---- build: the repo's locked pixi environment (unchanged: the one every check here runs on), and the Mojo module,
# built at /app (its library path is absolute: the runtime image keeps the same paths)
FROM ghcr.io/prefix-dev/pixi:0.80.0 AS build
WORKDIR /app
COPY pixi.toml pixi.lock ./
RUN pixi install --locked -e default
COPY . .
RUN rm -rf starter && pixi run bash scripts/build.sh omxplorer web \
    && pixi run bash scripts/mxbuild.sh hosts/validate_main.mojo -o build/omxplorer/web/validate

# ---- run
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin omx
# only what the server runs (round 3: the whole checkout, its build outputs and the 5 GB environment were copied): the
# environment without its headers, docs and static libraries or the tools only checks use (Polars, DuckDB); the web host
# and its files, the PDF printer an export pack uses, the start command, the module and its upload check
COPY --from=build /app/.pixi/envs/default /app/.pixi/envs/default
RUN cd /app/.pixi/envs/default && rm -rf include share/doc share/man share/info \
        lib/python3*/site-packages/polars* lib/python3*/site-packages/_polars* lib/python3*/site-packages/duckdb* lib/python3*/site-packages/_duckdb* \
    && find lib -name '*.a' -delete
COPY --from=build /app/mojoui/hosts/web.py /app/mojoui/hosts/web.py
COPY --from=build /app/mojoui/hosts/static /app/mojoui/hosts/static
COPY --from=build /app/mojoui/pack_pdf.py /app/mojoui/pack_pdf.py
COPY --from=build /app/scripts/web-start /app/scripts/web-start
COPY --from=build /app/build/omxplorer/web /app/build/omxplorer/web
# Export pack prints its PDFs with Chromium (mojoui/pack_pdf.py, through Playwright): Ubuntu's chromium is a snap, which
# doesn't run in a container, so Playwright's own build goes in, with the libraries it needs (round 4)
ENV PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright
RUN /app/.pixi/envs/default/bin/python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
COPY starter /data/robot
RUN chmod -R a-w /app /data && mkdir -p /tmp/omxcode /tmp/home && chown omx /tmp/omxcode /tmp/home
WORKDIR /app
USER 10001
ENV MOJOUI_PUBLIC=1 \
    OMX_STARTER=/data/robot \
    HOST=0.0.0.0 \
    HOME=/tmp/home \
    OMXCODE_UPLOADS=/tmp/omxcode/uploads \
    OMX_DOCUMENTS=/tmp/omxcode/documents \
    OMX_CONFIG=/tmp/omxcode/config \
    MOJOUI_PYTHON=/app/.pixi/envs/default/bin/python \
    PATH=/app/.pixi/envs/default/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s \
    CMD ["/app/.pixi/envs/default/bin/python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT', '8080'), timeout=4)"]
CMD ["/app/scripts/web-start"]
