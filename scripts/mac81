#!/usr/bin/env bash
# Goal 81's tests on the owner's M4 over SSH: scripts/mac81 glyphs|image|clock|apps. Sources go to ~/omxcode-g81 (made if
# missing); Mojo is the toolchain in ~/omxcode-g54 (read only). One batch at a time (flock ~/.cache/omx-mac.lock).
# Exit 75 with UNREACHABLE when the Mac can't be reached.
set -uo pipefail
cd "$(dirname "$0")/.."
what=${1:?glyphs|image|clock|apps}
key=${MAC_SSH_KEY:-$HOME/.ssh/edx_mac}
user=${MAC_SSH:-bhoomijaprasad@100.76.9.101}
opts=(-i "$key" -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=yes)
if [ -z "${G81_LOCKED:-}" ]; then G81_LOCKED=1 exec flock -w 5400 "$HOME/.cache/omx-mac.lock" "$0" "$@"; fi
if ! ssh "${opts[@]}" "$user" true 2>/dev/null; then  # (Tailscale down: the house network)
  ping -c3 -W2 10.0.0.74 >/dev/null 2>&1
  opts+=(-o HostKeyAlias=100.76.9.101); user=${user%@*}@10.0.0.74
  ssh "${opts[@]}" "$user" true 2>/tmp/mac81.err || { echo "UNREACHABLE: $(head -c 200 /tmp/mac81.err)"; exit 75; }
fi
mkdir -p build/g81
tar -czf build/g81/mac-src.tar.gz --exclude=__pycache__ mojoui themes hosts vendor fonts tests apple examples/kitchen examples/expenses examples/gallery scripts/mac81-run scripts/mac81-clock
ssh "${opts[@]}" "$user" 'mkdir -p ~/omxcode-g81' && scp -q "${opts[@]}" build/g81/mac-src.tar.gz "$user":omxcode-g81/ || { echo "UNREACHABLE: copy"; exit 75; }
ssh "${opts[@]}" "$user" "cd ~/omxcode-g81 && rm -rf src && mkdir src && tar -xzf mac-src.tar.gz -C src && caffeinate -is bash src/scripts/mac81-run $what"
