#!/usr/bin/env bash
# Goal 82's Mojo tests on the owner's M4 over SSH: scripts/mac82 tests/test_a.mojo [tests/test_b.mojo …]. Each is built
# (mojo build, with pnote's modules: job threads need a binary) and run there; its output comes back. Sources go to ~/omxcode-g82b (made if missing); Mojo is the toolchain in
# ~/omxcode-g54 (read only). One batch at a time: it takes ~/.cache/omx-mac.lock itself (never run it under that lock).
# Exit 75 with UNREACHABLE when the Mac can't be reached.
set -uo pipefail
cd "$(dirname "$0")/.."
[ $# -gt 0 ] || { echo "usage: scripts/mac82 tests/test_x.mojo …"; exit 2; }
key=${MAC_SSH_KEY:-$HOME/.ssh/edx_mac}
user=${MAC_SSH:-bhoomijaprasad@100.76.9.101}
opts=(-i "$key" -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=yes)
if [ -z "${G82_LOCKED:-}" ]; then G82_LOCKED=1 exec flock -w 5400 "$HOME/.cache/omx-mac.lock" "$0" "$@"; fi
if ! ssh "${opts[@]}" "$user" true 2>/dev/null; then  # (Tailscale down: the house network)
  ping -c3 -W2 10.0.0.74 >/dev/null 2>&1
  opts+=(-o HostKeyAlias=100.76.9.101); user=${user%@*}@10.0.0.74
  ssh "${opts[@]}" "$user" true 2>/tmp/mac82.err || { echo "UNREACHABLE: $(head -c 200 /tmp/mac82.err)"; exit 75; }
fi
mkdir -p build/g82
tar -czf build/g82/mac-src.tar.gz --exclude=__pycache__ mojoui vendor fonts themes examples/pnote tests/fixtures/archive "$@"
ssh "${opts[@]}" "$user" 'mkdir -p ~/omxcode-g82b' && scp -q "${opts[@]}" build/g82/mac-src.tar.gz "$user":omxcode-g82b/ || { echo "UNREACHABLE: copy"; exit 75; }
cmd="cd ~/omxcode-g82b && rm -rf src && mkdir src && tar -xzf mac-src.tar.gz -C src && cd src && export PATH=\$HOME/.pixi/bin:\$PATH"
for t in "$@"; do
  n=$(basename "$t" .mojo)
  cmd+=" ; { echo '== $t'; caffeinate -is pixi run --frozen --manifest-path \$HOME/omxcode-g54/pixi.toml bash -c 'cd ~/omxcode-g82b/src && mojo build -I . -I vendor -I examples/pnote $t -o ../bin_$n -Xlinker -framework -Xlinker AppKit -Xlinker -lobjc > ../build_$n.log 2>&1 && ../bin_$n || { grep -A3 error ../build_$n.log | head -20; echo BUILD-FAILED; }' 2>&1; }"
done
ssh "${opts[@]}" "$user" "$cmd" | grep -v -E "warning:|~~~|^ *\^ *$|note:|Imported from|Included from|unsafe_ptr|^ +ptr$|telemetry|^ +var |^ +_ = |^ +if |^ +return |^ +for "
