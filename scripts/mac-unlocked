#!/usr/bin/env bash
# The Mac's whole timing half in one command, for when its screen is unlocked (goal 79, continuation 23). About 30 minutes a
# screen (the web in a visible window of the Mac's own Chrome 10, pnote's work rows 6, the paced race 9, start-up 4), and 10 more for
# the first frames after a pause (MAC_FIRSTFRAMES=0 leaves them out). Every screen macOS shows windows on is raced, each with a
# table of its own (mirrored screens are one; for two tables: System Settings → Displays → Extended, the owner's to set).
# It refuses, changing nothing and judging nothing, when: the screen is locked; the app doesn't come to the front; the web's
# window isn't visible, or is drawn at another scale or refresh than native's; or the Mac is busy (load 3 or more).
# Chrome opens a window of its own for a while, with a profile of its own (~/omxcode-g79-web/tmp): the owner's isn't touched.
# Before: unlock the Mac, plug it in, leave it alone, nothing else running on it.
#   MAC_SSH=user@host scripts/mac-unlocked [--probe]        → docs/goals/79/race-mac.md, build/g79/race-logs/mac-*, build/g79/mac-firstframes-*.txt
set -uo pipefail
cd "$(dirname "$0")/.."
: "${MAC_SSH:?set MAC_SSH=user@host}"
export MAC_SSH
printf '%s\n' wait:800 window:1440x900 framebench:desk=open,1 quit > build/mac-unlocked.steps
MAC_ENV="PNOTE_DB={data}/pn.db,OMX_CONFIG={data}/cfg-probe-$(date +%s),MOJOUI_BENCH_PACED=1,MOJOUI_BENCHSTATE=1" scripts/mac-ssh pnote build/mac-unlocked.steps build/g79/ref-mac/pn.db > build/mac-unlocked.log 2>&1
r=$(tail -1 build/mac-unlocked.log)
state=$(grep -h "^BENCHSTATE" "$r/stdout.txt" 2>/dev/null | tail -1)
echo "${state:-no BENCHSTATE: $(tail -1 build/mac-unlocked.log)}"
case $state in
  *"active=1 key=1 locked=0"*) echo "The Mac is unlocked and the app came to the front: measuring (about 30 minutes a screen, and 10; leave it alone)." ;;
  *) echo "REFUSED: the screen is locked, or the app isn't in front. Nothing was measured."; exit 2 ;;
esac
[ "${1:-}" = --probe ] && exit 0
scripts/mac-frames || echo "(mac-frames failed: the rows below are judged all the same)"
pixi run python -B - <<'P'
import importlib.util, os, subprocess
sp = importlib.util.spec_from_file_location("c", "docs/goals/79-check.py"); c = importlib.util.module_from_spec(sp); sp.loader.exec_module(c)
t = subprocess.run(["scripts/mac-ssh-test", "tests/test_canvasload.mojo"], capture_output=True, text=True, timeout=900, env=dict(os.environ, MAC_TEST_BUILD="1", MAC_TEST_LINK="-Xlinker -lobjc -Xlinker -framework -Xlinker Foundation"))  # (the open's contract, run there; M6 runs it here first, and this script didn't, so the rows said it failed)
c.OPEN_TEST_OK[0] = "canvasload: ok" in t.stdout
print("test_canvasload on the Mac:", "ok" if c.OPEN_TEST_OK[0] else t.stdout[-400:])
print("M6, the Mac's half:", *c.m6_mac(c.OUT / "race"))
P
[ "${MAC_FIRSTFRAMES:-1}" = 0 ] || scripts/mac-firstframes
