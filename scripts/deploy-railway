#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1 && tput clear 2>/dev/null; then return 0; fi
  printf '\033[2J\033[3J\033[H'
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else false; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
# quotes or a plain dotenv double-quoted value undone.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line value sq="'\\''"; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  value="${line#*=}"
  if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//"$sq"/\'}"
  elif [[ "$value" == \"*\" ]]; then
    value="${value:1:${#value}-2}"
    [[ "$value" == *[\\\$\"]* ]] && return 1   # escapes, $ or ": can't decode safely; ask again
  fi
  printf '%s' "$value"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret), edited
# with Readline. Fails at EOF with no input.
ask() {
  local key="$1" prompt="$2" current input s=$'\001' e=$'\002' p rc=0
  current=$(_existing "$key" || true)
  # Readline needs the colour codes wrapped in \001..\002 to place the cursor.
  p="  $s$BOLD$e$prompt$s$RESET$e "
  [[ -n "$current" ]] && p+="$s$DIM$e[Enter keeps current]$s$RESET$e "
  read -e -r -p "$p" input || rc=1
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input rc=0
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || rc=1
  printf '\n'
  if (( rc )) && [[ -z "$input" ]]; then return 1; fi
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY='VALUE' into ENV_FILE (replaces any existing
# line) and sets $KEY. Idempotent. Creates ENV_FILE at mode 0600; writes through
# a symlink and keeps an existing file's mode.
write_env() {
  local key="$1" value="$2" tmp sq="'\\''"
  [[ -e "$ENV_FILE" ]] || (umask 077 && : > "$ENV_FILE")
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf "%s='%s'\n" "$key" "${value//\'/$sq}" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
  printf -v "$key" '%s' "$value"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# Keep every stage inside run_wizard and the last line as is: bash then parses
# the whole file before the first prompt, so an edit mid-run can't break it.
# ──────────────────────────────────────────────────────────────────────────

run_wizard() {

TOTAL_STAGES=9
cd "$(dirname "$0")/.."
SERVICE="${RAILWAY_SERVICE_NAME:-omxplorer-web}"
DOMAIN="${OMX_DOMAIN:-app.omxlabs.tech}"
DEPLOY="build/deploy/app"

banner "omxplorer on Railway: from railway login to https://$DOMAIN (goal 62)"

stage "Railway CLI and your account"
say "This puts the hosted copy (Dockerfile.web: public mode, the robot starter baked in, CPU only) on Railway,"
say "then plays the robot story against the live address. Plan: Hobby (docs/research/railway.md: up to 8 GB / 8 vCPU"
say "a replica, billed on what it uses). Nothing is deployed until stage 5 asks."
command -v railway >/dev/null || { warn "no railway CLI: npm i -g @railway/cli, then run this again"; exit 1; }
step "railway $(railway --version 2>/dev/null | cut -d' ' -f2)"
if ! railway whoami >/dev/null 2>&1; then
  step "Not signed in: a browser opens for railway login."
  railway login
fi
railway whoami
pause

stage "The starter and the build folder"
if [[ ! -f build/starter/robot/story.json ]]; then
  say "No robot starter yet. It's made from goal 47's full DROID set (fleet.csv, telemetry.parquet, clips/, paper/)."
  ask G47_FULL "Path of goal 47's full set (the folder with fleet.csv):"
  pixi run python scripts/starter.py --from "$G47_FULL" --to build/starter/robot
fi
step "Staging this repo's last commit + the starter into $DEPLOY (about 1.2 GB):"
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || warn "uncommitted changes aren't staged (git archive takes the last commit)"
scripts/stage-web "$DEPLOY"
pause

stage "A Railway project for it"
say "Creates the project 'omxplorer' in your account and links $DEPLOY to it (railway init)."
if (cd "$DEPLOY" && railway status >/dev/null 2>&1); then
  step "$DEPLOY is linked already:"; (cd "$DEPLOY" && railway status)
elif confirm "Create the Railway project 'omxplorer' now?"; then
  (cd "$DEPLOY" && railway init --name omxplorer)
else
  warn "stopped before creating anything"; exit 0
fi
pause

stage "The service and its settings"
say "A service named $SERVICE, and its variables (the image sets the rest: public mode, the starter, \$PORT)."
(cd "$DEPLOY" && railway add --service "$SERVICE") || note "(the service may exist already)"
(cd "$DEPLOY" && railway variable set --service "$SERVICE" --skip-deploys \
  MOJOUI_MAX_SESSIONS=6 MOJOUI_IDLE_S=900 MOJOUI_WAIT_S=240 RAILWAY_DEPLOYMENT_DRAINING_SECONDS=10)
say "Two settings the CLI can't make (dashboard → the project → $SERVICE → Settings):"
step "Deploy → Healthcheck Path: /health   (Healthcheck Timeout: 300)"
step "Deploy → Restart Policy: Always   (a crash restarts it; On Failure stops after 10)"
(cd "$DEPLOY" && railway open) || true
pause "Press Enter once both are set"

stage "Deploy"
say "Uploads $DEPLOY (about 1.2 GB) and builds the image on Railway (pixi environment and the Mojo module:"
say "allow 10–20 minutes the first time; Hobby's build limit is 40)."
if confirm "Deploy now (railway up)?"; then
  (cd "$DEPLOY" && railway up --service "$SERVICE" --detach)
else
  warn "not deployed"; exit 0
fi
step "Following the build log (Ctrl+C when it says the server is up: 'mojoui web: public mode')"
(cd "$DEPLOY" && railway logs --service "$SERVICE") || true
pause

stage "A Railway address first"
say "Before your own domain: a railway.app address, to play the story against."
(cd "$DEPLOY" && railway domain --service "$SERVICE") || true
ask RAILWAY_URL "Paste the https://….up.railway.app address it printed:"
step "Health: $(curl -fsS "${RAILWAY_URL%/}/health" || echo 'not answering yet')"
pause

stage "Play the story against it"
say "A headless browser plays the whole robot story there, as a visitor would (docs/goals/62/story.py)."
pixi run python docs/goals/62/story.py --url "${RAILWAY_URL%/}/" --out build/g62/railway-visitor --no-pack \
  | grep -E "^### BEAT|^RESULT" || warn "the story didn't pass there: build/g62/railway-visitor/results.json"
pause

stage "Who the server thinks visits (X-Real-IP)"
say "The per-address limits read X-Real-IP, which Railway's proxy should set to the visitor's own address."
say "A page load that sends a made-up one (203.0.113.77, an address kept for examples), then what the server recorded:"
curl -fsS -o /dev/null -H "X-Real-IP: 203.0.113.77" -H "Sec-Fetch-Dest: document" -H "Sec-Fetch-Mode: navigate" "${RAILWAY_URL%/}/" || true
sleep 3
SEEN=$( (cd "$DEPLOY" && timeout 20 railway logs --service "$SERVICE" 2>/dev/null) | grep "SESSION: made for" | tail -1 || true)
step "The server recorded: ${SEEN:-nothing yet}"
case "$SEEN" in
  *203.0.113.77*) warn "the made-up address came through: X-Real-IP isn't the proxy's own, so the per-address limits can be dodged (the cap and the server-wide rates still hold). Tell Claude before going live." ;;
  "") warn "no 'SESSION: made for' line yet: run railway logs --service $SERVICE and look for it" ;;
  *) step "It recorded your own address, not the made-up one: the per-address limits see real visitors." ;;
esac
pause

stage "Your domain: $DOMAIN"
say "Railway gives the DNS records to add at your DNS host (a CNAME and a TXT for the check)."
(cd "$DEPLOY" && railway domain "$DOMAIN" --service "$SERVICE") || true
step "Add both records at your DNS host. On Cloudflare: SSL mode Full (not Full (strict)) while Railway issues the certificate."
open_url "https://dash.cloudflare.com/"
step "Waiting for the certificate (up to an hour; railway domain status $DOMAIN shows where it is)."
until curl -fsS "https://$DOMAIN/health" >/dev/null 2>&1; do sleep 30; printf '.'; done; printf '\n'
step "https://$DOMAIN/health: $(curl -fsS "https://$DOMAIN/health")"
pause

stage "The story on https://$DOMAIN"
pixi run python docs/goals/62/story.py --url "https://$DOMAIN/" --out build/g62/live-visitor \
  | grep -E "^### BEAT|^RESULT" || warn "the story didn't pass on $DOMAIN: build/g62/live-visitor/results.json"
say "Live: https://$DOMAIN · logs: railway logs --service $SERVICE · roll back: railway down --service $SERVICE"

finish
}

run_wizard "$@"; exit
