#!/usr/bin/env bash
# Builds the hosted copy's image (Dockerfile.web, from scripts/stage-web's folder) and plays the robot story against it,
# as a visitor would: the container runs as it will on Railway (read-only root, /tmp writable, $PORT), CPU only.
# Needs a Docker this user can reach (goal 62 M5's image half).   scripts/image-check
set -euo pipefail
cd "$(dirname "$0")/.."
docker info >/dev/null 2>&1 || { echo "Docker isn't reachable by $USER (try: sudo usermod -aG docker \$USER && newgrp docker)" >&2; exit 2; }
DIR=$(scripts/stage-web | cut -d' ' -f1)
TAG=omxplorer-web:check
docker build -t "$TAG" "$DIR"
PORT=$(pixi run python -c "import socket; s = socket.socket(); s.bind(('127.0.0.1', 0)); print(s.getsockname()[1])")
ID=$(docker run -d --rm --read-only --tmpfs /tmp:exec,size=4g -e PORT=8080 -p "127.0.0.1:$PORT:8080" "$TAG")
trap 'docker stop "$ID" >/dev/null 2>&1 || true' EXIT
for _ in $(seq 1 300); do curl -fsS "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break; sleep 1; done
curl -fsS "http://127.0.0.1:$PORT/health"; echo
[ "$(docker exec "$ID" id -u)" != 0 ] || { echo "the container runs as root" >&2; exit 1; }
docker exec "$ID" sh -c 'touch /app/x 2>/dev/null || touch /data/robot/x 2>/dev/null' && { echo "the app or the data is writable" >&2; exit 1; }
# the whole story against the container, Export pack included (its PDFs print with the image's Chromium: round 4)
pixi run python docs/goals/62/story.py --url "http://127.0.0.1:$PORT/" --out build/g62/image-visitor
pixi run python -I -c 'import json, sys; b = json.load(open(sys.argv[1]))["beats"]; p = b.get("Export pack downloads", {}); print("Export pack:", p.get("note")); sys.exit(0 if p.get("ok") else 1)' build/g62/image-visitor/results.json \
    || { echo "Export pack didn't arrive from the container" >&2; exit 1; }
docker logs "$ID" 2>&1 | tail -5
