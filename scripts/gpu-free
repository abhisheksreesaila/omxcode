#!/usr/bin/env python3
"""Is this machine free for a GPU program, a race, a test window or a check? (goal 79, continuation 20)

Three unlogged power-offs (11-23 00:36, 13:24, 22:55) all had another project's LLM job on both GPUs at the moment a build
or race of ours ran. So none of ours starts while one does: exit 0 only when no such process runs and nobody holds more
than 4 GB on a GPU; otherwise exit 75 and one line saying why. There is no waiting here and no "go anyway": the caller
tries again later or does something else.   scripts/gpu-free && scripts/testscreen …
"""
import os
import re
import subprocess
import sys

JOBS = re.compile(r"(^|/)omx-(?!console)[\w.-]+|speed_study|llama|q3_hybrid|expert-dispatch|omxpert-evolve|vllm|max serve")
LIMIT_MIB = 4096


def busy():
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if int(pid) in (os.getpid(), os.getppid()):
            continue
        try:
            args = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        args = [a.decode("utf-8", "replace") for a in args if a]
        line = " ".join(args)
        if not args or "shell-snapshots" in line or "gpu-free" in line:  # (a shell whose command names them, this script)
            continue
        if args[0].rsplit("/", 1)[-1] in ("grep", "pgrep", "ugrep", "rg", "tail", "less", "cat", "vim", "nvim", "git"):
            continue
        # (the program and its script, not every word of its arguments: a browser tab's title isn't a job)
        # (a lock file's name isn't a job either: `flock ~/.cache/omx-mac.lock …` waits for the Mac, not for a GPU here)
        head = " ".join(a for a in args[:4] if not a.endswith(".lock"))
        m = JOBS.search(head)
        if m and "chrom" not in args[0] and "claude" not in args[0]:
            return f"process {pid} is another project's job: {head[:100]}"
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.used", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"nvidia-smi doesn't answer ({e})"
    if r.returncode != 0:
        return f"nvidia-smi fails: {(r.stdout + r.stderr).strip()[:100]}"
    for line in r.stdout.strip().splitlines():
        i, used = (x.strip() for x in line.split(","))
        if int(used) > LIMIT_MIB:
            return f"GPU {i} holds {used} MiB"
    for unit in ("omx-nightly.service", "omx-day.service"):
        s = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True).stdout.strip()
        if s in ("active", "activating"):
            return f"{unit} is {s}"
    return ""


why = busy()
if why:
    print("gpu-free: NO: " + why, file=sys.stderr)
    sys.exit(75)
print("gpu-free: yes")
